<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="72dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="16dp"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvItemNombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.EduTools.Cuerpo"
            android:textStyle="bold"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/tvItemRol"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textAppearance="@style/TextAppearance.EduTools.Secundario"
            android:importantForAccessibility="no" />
    </LinearLayout>

    <!-- El estado lleva texto explicito, no se comunica solo por color. -->
    <TextView
        android:id="@+id/tvItemEstado"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:background="@color/edu_primario_claro"
        android:textColor="@color/edu_primario"
        android:textSize="13sp"
        android:importantForAccessibility="no" />

</LinearLayout>
