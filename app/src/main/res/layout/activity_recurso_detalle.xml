<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/edu_fondo">

    <include layout="@layout/toolbar_edu" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvDetalleTitulo"
                android:tag="encabezado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/edu_texto" />

            <!-- Tipo -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/recurso_tipo"
                android:textAllCaps="true"
                android:textSize="12sp"
                android:textColor="@color/edu_texto_secundario" />

            <TextView
                android:id="@+id/tvDetalleTipo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.EduTools.Cuerpo" />

            <!-- Categoria -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/recurso_categoria"
                android:textAllCaps="true"
                android:textSize="12sp"
                android:textColor="@color/edu_texto_secundario" />

            <TextView
                android:id="@+id/tvDetalleCategoria"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.EduTools.Cuerpo" />

            <!-- Asignatura -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/recurso_asignatura"
                android:textAllCaps="true"
                android:textSize="12sp"
                android:textColor="@color/edu_texto_secundario" />

            <TextView
                android:id="@+id/tvDetalleAsignatura"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.EduTools.Cuerpo" />

            <!-- Descripcion -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/recurso_descripcion"
                android:textAllCaps="true"
                android:textSize="12sp"
                android:textColor="@color/edu_texto_secundario" />

            <TextView
                android:id="@+id/tvDetalleDescripcion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.EduTools.Cuerpo" />

            <!-- Contenido / vista previa -->
            <TextView
                android:id="@+id/tvPreviewTitulo"
                android:tag="encabezado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/preview_titulo"
                android:textAllCaps="true"
                android:textSize="12sp"
                android:textColor="@color/edu_texto_secundario" />

            <FrameLayout
                android:id="@+id/marcoContenido"
                android:layout_width="match_parent"
                android:layout_height="320dp"
                android:layout_marginTop="8dp"
                android:background="@color/edu_superficie"
                android:visibility="gone">

                <WebView
                    android:id="@+id/webContenido"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/preview_titulo" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvPreviewMensaje"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textAppearance="@style/TextAppearance.EduTools.Cuerpo"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnAbrirEnlace"
                style="@style/Widget.EduTools.Boton.Secundario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/preview_abrir_enlace"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvPreviewAviso"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/preview_aviso_externo"
                android:textAppearance="@style/TextAppearance.EduTools.Secundario"
                android:visibility="gone" />

            <!-- Autor -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/recurso_autor"
                android:textAllCaps="true"
                android:textSize="12sp"
                android:textColor="@color/edu_texto_secundario" />

            <TextView
                android:id="@+id/tvDetalleAutor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.EduTools.Cuerpo" />

            <Button
                android:id="@+id/btnEditarRecurso"
                style="@style/Widget.EduTools.Boton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="@string/recurso_editar" />

            <Button
                android:id="@+id/btnEliminarRecurso"
                style="@style/Widget.EduTools.Boton.Secundario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/recurso_eliminar" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
