<?xml version="1.0" encoding="utf-8"?>
<!--
    Se prohibe el trafico en texto plano: todo el consumo de la API va por HTTPS.
    Sin excepciones (se saco la del host de desarrollo 10.0.2.2/localhost).
-->
<network-security-config>

    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

</network-security-config>
