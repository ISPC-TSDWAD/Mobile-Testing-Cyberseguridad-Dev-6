<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_logo_edutools"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.EduTools"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="false">

        <!-- ================= RAIZ DE NAVEGACION ================= -->
        <activity
            android:name=".LoginActivity"
            android:exported="true"
            android:label="@string/title_login">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:label="@string/title_main" />

        <!-- ================= MODULO RECURSOS ================= -->
        <activity
            android:name=".RecursosActivity"
            android:exported="false"
            android:label="@string/title_recursos"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".RecursoDetalleActivity"
            android:exported="false"
            android:label="@string/title_recurso_detalle"
            android:parentActivityName=".RecursosActivity" />

        <activity
            android:name=".RecursoFormActivity"
            android:exported="false"
            android:label="@string/title_recurso_form"
            android:parentActivityName=".RecursosActivity" />

        <!-- ================= MODULO USUARIOS ================= -->
        <activity
            android:name=".UsuariosActivity"
            android:exported="false"
            android:label="@string/title_usuarios"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".PerfilUsuarioActivity"
            android:exported="false"
            android:label="@string/title_perfil"
            android:parentActivityName=".UsuariosActivity" />

        <!-- ================= MULTIMEDIA / INSTITUCIONAL ================= -->
        <activity
            android:name=".MultimediaActivity"
            android:exported="false"
            android:label="@string/title_multimedia"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".ContactoActivity"
            android:exported="false"
            android:label="@string/title_contacto"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".AcercaDeActivity"
            android:exported="false"
            android:label="@string/title_acerca"
            android:parentActivityName=".MainActivity" />

    </application>

</manifest>
