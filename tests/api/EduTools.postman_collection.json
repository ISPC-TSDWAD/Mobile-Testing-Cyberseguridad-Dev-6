      "item": [
        {
          "name": "Login admin (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código de estado 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Content-Type es JSON\", () => pm.expect(pm.response.headers.get(\"Content-Type\") || \"\").to.include(\"application/json\"));",
                  "pm.test(\"Tiempo de respuesta < 800 ms\", () => pm.expect(pm.response.responseTime).to.be.below(800));",
                  "pm.test(\"Campos y tipos del cuerpo\", () => {",
                  "  const j = pm.response.json();",
                  "  pm.expect(j).to.have.property(\"access\"); pm.expect(j.access).to.be.a(\"string\");",
                  "  pm.expect(j).to.have.property(\"refresh\"); pm.expect(j.refresh).to.be.a(\"string\");",
                  "  pm.expect(j).to.have.property(\"is_staff\"); pm.expect(j.is_staff).to.be.a(\"boolean\");",
                  "  pm.expect(j).to.have.property(\"rol\"); pm.expect(j.rol).to.be.a(\"string\");",
                  "});",
                  "pm.test(\"Rol válido\", () => pm.expect([\"admin\",\"asesor\",\"maquetador\"]).to.include(pm.response.json().rol));",
                  "pm.environment.set(\"token\", pm.response.json().access);",
                  "pm.environment.set(\"refresh\", pm.response.json().refresh);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/token/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "token",
                ""
              ]
            }
          }
        },
