  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('Tiempo de respuesta menor a 800 ms', function () { pm.expect(pm.response.responseTime).to.be.below(800); });",
          "if (pm.response.code !== 204) { pm.test('Content-Type JSON', function () { pm.expect(pm.response.headers.get('Content-Type') || '').to.include('application/json'); }); }",
          "if (pm.response.code >= 400) { pm.test('Error estructurado', function () { const error = pm.response.json(); pm.expect(error).to.be.an('object'); pm.expect(Object.keys(error).length).to.be.above(0); }); }"
        ]
      }
    }
  ],
