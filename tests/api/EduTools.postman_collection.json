        {
          "name": "AUTH-01 Login valido (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Codigo 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Content-Type JSON', function () { pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'); });",
                  "const body = pm.response.json();",
                  "pm.test('Trae access, refresh, is_staff y rol con sus tipos', function () {",
                  "    pm.expect(body.access).to.be.a('string').and.not.empty;",
                  "    pm.expect(body.refresh).to.be.a('string').and.not.empty;",
                  "    pm.expect(body.is_staff).to.be.a('boolean');",
                  "    pm.expect(['admin', 'asesor', 'maquetador']).to.include(body.rol);",
                  "});",
                  "pm.environment.set('token', body.access);",
                  "pm.environment.set('refresh', body.refresh);",
                  "pm.test('Cuenta administradora', function () { pm.expect(pm.response.json().is_staff).to.eql(true); });"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
